{
  "name": "cloud-network-alert-notification-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "postinstall": "npm run install:all",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server"
  }
}
